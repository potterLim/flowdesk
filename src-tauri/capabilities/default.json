{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    "opener:default",
    "opener:allow-open-path",
    "sql:default"
  ]
}
